DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads
# Set true behind Coolify HTTPS; false only for local HTTP.
COOKIE_SECURE=false
# Twilio Verify credentials are required to publish listings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional S3-compatible storage. Otherwise use the persistent uploads volume.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bootstrap a single administrator using npm run db:seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
