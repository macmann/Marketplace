# Production: existing Coolify shared services. Replace placeholders securely.
DATABASE_URL=postgresql://marketplace_user:CHANGE_ME@shared-postgres:5432/marketplace
REDIS_URL=redis://shared-redis:6379/0
APP_URL=https://market.example.com
COOKIE_SECURE=true
REDIS_KEY_PREFIX=marketplace
COOLIFY_NETWORK=coolify
# Pin both image refs to the same sha-<full-commit> tag after CI publication.
MARKETPLACE_WEB_IMAGE=ghcr.io/macmann/marketplace-web:main
MARKETPLACE_TOOLS_IMAGE=ghcr.io/macmann/marketplace-tools:main
# Compose fixes this to the persistent uploads mount. Local development may override.
UPLOAD_DIR=./uploads
# Optional Twilio Verify for phone sign-in, phone verification and SMS recovery.
# Publishing accepts verified email or phone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional S3-compatible storage. Otherwise use the persistent uploads volume.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bootstrap a single administrator using npm run db:seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional background Web Push. Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@example.com

# Optional worker-only image moderation; select OPENAI in admin Safety to enable.
# MANUAL is the default; LOCAL uses deterministic checks only.
OPENAI_API_KEY=

# Optional email verification/recovery, independent of SMS. Bare sender address.
SMTP_HOST=
SMTP_PORT=587
# blank selects implicit TLS for 465, mandatory STARTTLS for other ports
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
