{
  "name": "myanmar-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app lib scripts tests *.ts *.json *.yaml .github/workflows/*.yml",
    "format:check": "prettier --check app lib scripts tests *.ts *.json *.yaml .github/workflows/*.yml",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "bcryptjs": "^3.0.0",
    "bullmq": "^5.0.0",
    "myanmar-tools": "1.1.3",
    "next": "^16.0.0",
    "pg": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  }
}
